# Copiá este archivo como .env.local para ejecutar la aplicación Next.js.
# Nunca subas valores reales de claves, tokens o secretos al repositorio.

# -----------------------------------------------------------------------------
# Aplicación Next.js / Supabase
# -----------------------------------------------------------------------------
# URL del proyecto Supabase (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave pública (anon) del proyecto Supabase. Puede exponerse al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clave de servicio de Supabase. Solo servidor; nunca usar con prefijo NEXT_PUBLIC_.
# Se requiere para las operaciones de facturación electrónica.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token de acceso de AFIP SDK, requerido para emitir comprobantes electrónicos.
AFIPSDK_ACCESS_TOKEN=your-afipsdk-access-token

# Ambiente ARCA para configuración, pruebas y nuevas emisiones: HOMOLOGACION o PRODUCCION.
# Si se omite o tiene un valor no válido, se usa HOMOLOGACION.
ARCA_AMBIENTE=HOMOLOGACION

# Límite global FCE MiPyME para todas las nuevas emisiones.
# Las facturas y notas de crédito/débito por un importe igual o mayor se bloquean
# antes de consultar ARCA. Debe ser un monto positivo, por ejemplo 1000000.00.
FCE_MIPYME_MONTO_MINIMO=your-fce-mipyme-limit

# -----------------------------------------------------------------------------
# Comportamiento de la aplicación (opcionales)
# -----------------------------------------------------------------------------
# IVA_RATE acepta un coeficiente entre 0 y 1. Tiene precedencia sobre IVA_PERCENT.
IVA_RATE=0.21
# Alternativa a IVA_RATE: un porcentaje no negativo (por ejemplo, 21).
# IVA_PERCENT=21

# Nivel de logs: debug, info, warn, error o none. Por defecto: info.
LOG_LEVEL=info
# Alternativa pública a LOG_LEVEL para código de cliente. LOG_LEVEL tiene prioridad.
# NEXT_PUBLIC_LOG_LEVEL=info

# Registra cada solicitud atendida por el middleware cuando vale true. Por defecto: false.
LOG_EVERY_REQUEST=false

# -----------------------------------------------------------------------------
# Edge Function: send-turno-reminders
# Estas son secrets de Supabase Edge Functions, no variables que el navegador use.
# Configuralas en el proyecto remoto con `supabase secrets set --env-file .env.local`.
# -----------------------------------------------------------------------------
# URL del proyecto Supabase usada por la Edge Function.
SUPABASE_URL=https://your-project-ref.supabase.co

# Región y credenciales para el envío de correos con AWS SES.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Remitente por defecto y conjunto de configuración de SES (opcional).
SES_SENDER=no-reply@example.com
# SES_CONFIGURATION_SET=your-ses-configuration-set

# Zona horaria para calcular los recordatorios. Por defecto: America/Argentina/Buenos_Aires.
REMINDER_TIMEZONE=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------------------
# Supabase CLI local (opcionales; leídos por supabase/config.toml)
# -----------------------------------------------------------------------------
# Habilita las funciones de IA en Supabase Studio local.
# OPENAI_API_KEY=your-openai-api-key

# Solo si se habilita Twilio SMS en supabase/config.toml.
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Solo si se habilita el proveedor Apple en supabase/config.toml.
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your-apple-client-secret

# Solo para el motor experimental OrioleDB con almacenamiento S3 local.
# S3_HOST=your-bucket.s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key
