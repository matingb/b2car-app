        <mxCell id="Jyr7jFsrqrCyg2MLJppl-1080" parent="Jyr7jFsrqrCyg2MLJppl-1077" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=2;fontSize=10;fontColor=#808080;" value="bool" vertex="1">
          <mxGeometry height="20" width="118" x="202" as="geometry">
