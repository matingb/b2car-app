        <mxCell id="Jyr7jFsrqrCyg2MLJppl-1079" parent="Jyr7jFsrqrCyg2MLJppl-1077" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=4;" value="habilitada" vertex="1">
